{
  "name": "Requirements Gap Finder",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Streamlit", "onAutoForward": "openPreview" }
  }
}
